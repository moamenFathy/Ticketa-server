@model Ticketa.Core.DTOs.Dashboard.DashboardSummaryDto
@using Ticketa.Core.Enums
@using Ticketa.Core.Helpers
@inject TimeConversions TimeConversions

@{
    ViewData["Title"] = "Dashboard";
    var currencyFormat = new System.Globalization.CultureInfo("en-US");
}

<div class="space-y-6">
    <h1 class="text-2xl font-bold">Dashboard</h1>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="stat bg-base-100 rounded-box shadow-sm border border-base-200">
            <div class="stat-figure text-emerald-500 bg-emerald-500/10 p-2 rounded-xl">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-7"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <div class="stat-title">Revenue (30 days)</div>
            <div class="stat-value text-emerald-500" id="statRevenue">@Model.Revenue30Days.ToString("C0", currencyFormat)</div>
            <div class="stat-desc"><span id="statRevenueDays">@Model.RevenueTrend.Count</span> days of data</div>
        </div>

        <div class="stat bg-base-100 rounded-box shadow-sm border border-base-200">
            <div class="stat-figure text-primary bg-primary/10 p-2 rounded-xl">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-7"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/></svg>
            </div>
            <div class="stat-title">Bookings Today</div>
            <div class="stat-value text-primary" id="statBookingsToday">@Model.BookingsToday</div>
            <div class="stat-desc"><span id="statBookingsWeek">@Model.BookingsThisWeek</span> this week</div>
        </div>

        <div class="stat bg-base-100 rounded-box shadow-sm border border-base-200">
            <div class="stat-figure text-warning bg-warning/10 p-2 rounded-xl">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-7"><path d="M2 9a3 3 0 1 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 1 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M9 9h.01"/><path d="m15 9-6 6"/><path d="M15 15h.01"/></svg>
            </div>
            <div class="stat-title">Sold Out</div>
            <div class="stat-value text-warning" id="statSoldOut">@Model.SoldOutShowtimeCount</div>
            <div class="stat-desc">showtimes sold out</div>
        </div>

        <div class="stat bg-base-100 rounded-box shadow-sm border border-base-200">
            <div class="stat-figure text-info bg-info/10 p-2 rounded-xl">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-7"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
            </div>
            <div class="stat-title">Occupancy</div>
            <div class="stat-value text-info" id="statOccupancy">@Model.AverageOccupancyPercent%</div>
            <div class="stat-desc">avg seats filled</div>
        </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
        <div class="xl:col-span-2 bg-base-100 rounded-box shadow-sm border border-base-200 p-4">
            <h2 class="text-lg font-semibold mb-4">Revenue Trend (30 days)</h2>
            <div class="relative h-64">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>

        <div class="bg-base-100 rounded-box shadow-sm border border-base-200 p-4">
            <h2 class="text-lg font-semibold mb-4">Top Movies</h2>
            <div id="topMoviesList">
            @if (Model.TopMovies.Count == 0)
            {
                <p class="text-base-content/50 text-sm">No data yet.</p>
            }
            else
            {
                <div class="space-y-3">
                    @foreach (var movie in Model.TopMovies.Select((m, i) => new { m, i }))
                    {
                        <div class="flex items-center gap-3">
                            <span class="text-lg font-bold text-base-content/30 w-6">@(movie.i + 1)</span>
                            @if (!string.IsNullOrEmpty(movie.m.PosterPath))
                            {
                                <img src="https://image.tmdb.org/t/p/w92@(movie.m.PosterPath)" alt="@movie.m.Title" class="size-10 rounded object-cover" />
                            }
                            else
                            {
                                <div class="size-10 rounded bg-base-300 flex items-center justify-center text-xs text-base-content/50">N/A</div>
                            }
                            <div class="flex-1 min-w-0">
                                <p class="truncate font-medium text-sm">@movie.m.Title</p>
                                <p class="text-xs text-base-content/50">@movie.m.BookingCount bookings</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        </div>
    </div>

    <div class="bg-base-100 rounded-box shadow-sm border border-base-200 p-4">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold">Site Analytics (30 days)</h2>
            <span class="text-xs text-base-content/50">via Vercel Web Analytics</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="stat bg-base-200/50 rounded-box border border-base-200">
                <div class="stat-figure text-sky-500 bg-sky-500/10 p-2 rounded-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                </div>
                <div class="stat-title">Page Views</div>
                <div class="stat-value text-sky-500" id="statPageViews">—</div>
            </div>
            <div class="stat bg-base-200/50 rounded-box border border-base-200">
                <div class="stat-figure text-primary bg-primary/10 p-2 rounded-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <div class="stat-title">Visitors</div>
                <div class="stat-value text-primary" id="statVisitors">—</div>
            </div>
        </div>
        <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 mt-4">
            <div>
                <h3 class="text-sm font-medium mb-2 text-base-content/70">By Country</h3>
                <div class="relative h-48"><canvas id="analyticsCountryChart"></canvas></div>
            </div>
            <div>
                <h3 class="text-sm font-medium mb-2 text-base-content/70">By Device</h3>
                <div class="relative h-48"><canvas id="analyticsDeviceChart"></canvas></div>
            </div>
            <div>
                <h3 class="text-sm font-medium mb-2 text-base-content/70">By OS</h3>
                <div class="relative h-48"><canvas id="analyticsOsChart"></canvas></div>
            </div>
            <div>
                <h3 class="text-sm font-medium mb-2 text-base-content/70">By Browser</h3>
                <div class="relative h-48"><canvas id="analyticsBrowserChart"></canvas></div>
            </div>
        </div>
    </div>

    <div class="bg-base-100 rounded-box shadow-sm border border-base-200 p-4">
        <h2 class="text-lg font-semibold mb-4">Today's Showtimes</h2>
        <div id="todayShowtimesContainer">
        @if (Model.TodayShowtimes.Count == 0)
        {
            <p class="text-base-content/50 text-sm">No showtimes scheduled for today.</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Movie</th>
                            <th>Hall</th>
                            <th>Status</th>
                            <th>Seats</th>
                            <th>Occupancy</th>
                        </tr>
                    </thead>
                    <tbody id="todayShowtimesBody">
                        @foreach (var st in Model.TodayShowtimes)
                        {
                            var isRunning = st.Status == ShowtimeStatus.Scheduled && st.StartTime <= DateTime.UtcNow && st.EndTime > DateTime.UtcNow;
                            var statusLabel = isRunning ? "Running"
                                : st.Status == ShowtimeStatus.SoldOut ? "Sold Out"
                                : st.Status == ShowtimeStatus.Completed ? "Completed"
                                : st.Status == ShowtimeStatus.Scheduled ? "Scheduled"
                                : st.Status.ToString();

                            var statusClass = isRunning ? "badge-success"
                                : st.Status == ShowtimeStatus.SoldOut ? "badge-warning"
                                : st.Status == ShowtimeStatus.Completed ? "badge-ghost"
                                : "badge-info";

                            <tr>
                                <td class="whitespace-nowrap">
                                    @st.StartTime.ToLocalTime().ToString("HH:mm") – @st.EndTime.ToLocalTime().ToString("HH:mm")
                                </td>
                                <td class="font-medium">@st.MovieTitle</td>
                                <td>@st.HallName</td>
                                <td><span class="badge @statusClass badge-sm">@statusLabel</span></td>
                                <td>@st.BookedSeats / @st.VisibleSeats</td>
                                <td>
                                    <div class="flex items-center gap-2">
                                        <progress class="progress w-20 @(st.OccupancyPercent >= 90 ? "progress-error" : st.OccupancyPercent >= 70 ? "progress-warning" : "progress-success")" value="@st.OccupancyPercent" max="100"></progress>
                                        <span class="text-xs">@st.OccupancyPercent%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        </div>
    </div>

    <div class="bg-base-100 rounded-box shadow-sm border border-base-200 p-4" style="min-height:250px">
        <h2 class="text-lg font-semibold mb-4">Today's Timeline</h2>
        <div id="dashboardTimeline">
            <div class="timeline-empty">Loading...</div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/showtime-timeline.css" asp-append-version="true" />
    <style>
        .stat-value { font-size: 2rem; }
        #dashboardTimeline { min-height: 200px; }
        #dashboardTimeline .timeline-wrapper { --tl-hall-label: 110px; --tl-hour-width: 70px; --tl-row-height: 52px; }
        #dashboardTimeline .tl-bar-delete-btn { display: none; }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        const currencyFmt = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 0 });
        const todayStr = (() => { const d = new Date(); return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); })();

        const trendData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueTrend, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
        const chartCtx = document.getElementById('revenueChart').getContext('2d');

        window.revenueChart = new Chart(chartCtx, {
            type: 'line',
            data: {
                labels: trendData.map(d => d.date),
                datasets: [{
                    label: 'Revenue',
                    data: trendData.map(d => d.amount),
                    borderColor: '#e06b24',
                    backgroundColor: 'rgba(224, 107, 36, 0.12)',
                    pointBackgroundColor: '#e06b24',
                    pointBorderColor: '#fff',
                    pointHoverRadius: 6,
                    pointHoverBackgroundColor: '#e06b24',
                    pointHoverBorderColor: '#fff',
                    fill: true,
                    tension: 0.35,
                    pointRadius: 3,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { callback: v => '$' + Number(v).toLocaleString() }
                    }
                }
            }
        });

        function renderTopMovies(movies) {
            if (!movies || movies.length === 0) return '<p class="text-base-content/50 text-sm">No data yet.</p>';
            let html = '<div class="space-y-3">';
            movies.forEach((m, i) => {
                html += `<div class="flex items-center gap-3">
                    <span class="text-lg font-bold text-base-content/30 w-6">${i + 1}</span>
                    ${m.posterPath ? `<img src="https://image.tmdb.org/t/p/w92${m.posterPath}" alt="${m.title}" class="size-10 rounded object-cover" />` : `<div class="size-10 rounded bg-base-300 flex items-center justify-center text-xs text-base-content/50">N/A</div>`}
                    <div class="flex-1 min-w-0">
                        <p class="truncate font-medium text-sm">${m.title}</p>
                        <p class="text-xs text-base-content/50">${m.bookingCount} bookings</p>
                    </div>
                </div>`;
            });
            return html + '</div>';
        }

        function renderTodayShowtimes(showtimes) {
            if (!showtimes || showtimes.length === 0) return '';
            const now = new Date();
            return showtimes.map(st => {
                const start = new Date(st.startTime);
                const end = new Date(st.endTime);
                const isRunning = st.status === 0 && start <= now && end > now;
                const label = isRunning ? 'Running' : st.status === 1 ? 'Sold Out' : st.status === 2 ? 'Completed' : 'Scheduled';
                const cls = isRunning ? 'badge-success' : st.status === 1 ? 'badge-warning' : st.status === 2 ? 'badge-ghost' : 'badge-info';
                const pcls = st.occupancyPercent >= 90 ? 'progress-error' : st.occupancyPercent >= 70 ? 'progress-warning' : 'progress-success';
                return `<tr>
                    <td class="whitespace-nowrap">${start.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})} – ${end.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}</td>
                    <td class="font-medium">${st.movieTitle}</td>
                    <td>${st.hallName}</td>
                    <td><span class="badge ${cls} badge-sm">${label}</span></td>
                    <td>${st.bookedSeats} / ${st.visibleSeats}</td>
                    <td><div class="flex items-center gap-2"><progress class="progress w-20 ${pcls}" value="${st.occupancyPercent}" max="100"></progress><span class="text-xs">${st.occupancyPercent}%</span></div></td>
                </tr>`;
            }).join('');
        }

        function updateDashboard(summary) {
            document.getElementById('statRevenue').textContent = currencyFmt.format(summary.revenue30Days);
            document.getElementById('statRevenueDays').textContent = summary.revenueTrend?.length ?? 0;
            document.getElementById('statBookingsToday').textContent = summary.bookingsToday;
            document.getElementById('statBookingsWeek').textContent = summary.bookingsThisWeek;
            document.getElementById('statSoldOut').textContent = summary.soldOutShowtimeCount;
            document.getElementById('statOccupancy').textContent = summary.averageOccupancyPercent + '%';

            const ml = document.getElementById('topMoviesList');
            if (ml) ml.innerHTML = renderTopMovies(summary.topMovies);

            const tc = document.getElementById('todayShowtimesContainer');
            if (tc) {
                const showtimes = summary.todayShowtimes ?? [];
                if (showtimes.length > 0) {
                    const rows = renderTodayShowtimes(showtimes);
                    const tb = document.getElementById('todayShowtimesBody');
                    if (tb) {
                        tb.innerHTML = rows;
                    } else {
                        tc.innerHTML = `<div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Time</th><th>Movie</th><th>Hall</th><th>Status</th><th>Seats</th><th>Occupancy</th></tr></thead><tbody id="todayShowtimesBody">${rows}</tbody></table></div>`;
                    }
                } else if (document.getElementById('todayShowtimesBody')) {
                    tc.innerHTML = '<p class="text-base-content/50 text-sm">No showtimes scheduled for today.</p>';
                }
            }

            if (window.revenueChart && summary.revenueTrend) {
                window.revenueChart.data.labels = summary.revenueTrend.map(d => d.date);
                window.revenueChart.data.datasets[0].data = summary.revenueTrend.map(d => d.amount);
                window.revenueChart.update('none');
            }
        }

        function pollDashboard() {
            fetch('/Dashboard/Summary')
                .then(r => r.json())
                .then(s => updateDashboard(s))
                .catch(() => {});
        }

        pollDashboard();
        setInterval(pollDashboard, 15000);

        const analyticsCharts = {};

        function renderAnalyticsChart(id, items) {
            const el = document.getElementById(id);
            if (!el) return;
            const wrap = el.parentElement;
            const empty = !items || items.length === 0;

            wrap.querySelector('.analytics-empty')?.remove();

            if (empty) {
                if (analyticsCharts[id]) { analyticsCharts[id].destroy(); delete analyticsCharts[id]; }
                const p = document.createElement('p');
                p.className = 'analytics-empty text-base-content/50 text-sm';
                p.textContent = 'No data yet.';
                wrap.appendChild(p);
                return;
            }

            const labels = items.map(i => i.label);
            const data = items.map(i => i.visitors);

            if (analyticsCharts[id]) {
                analyticsCharts[id].data.labels = labels;
                analyticsCharts[id].data.datasets[0].data = data;
                analyticsCharts[id].update('none');
            } else {
                analyticsCharts[id] = new Chart(el.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels,
                        datasets: [{
                            label: 'Visitors',
                            data,
                            backgroundColor: 'rgba(224, 107, 36, 0.75)',
                            hoverBackgroundColor: 'rgba(224, 107, 36, 1)',
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                    }
                });
            }
        }

        function updateAnalytics(a) {
            if (!a) return;
            document.getElementById('statPageViews').textContent = (a.pageViews ?? 0).toLocaleString();
            document.getElementById('statVisitors').textContent = (a.visitors ?? 0).toLocaleString();
            renderAnalyticsChart('analyticsCountryChart', a.byCountry ?? []);
            renderAnalyticsChart('analyticsDeviceChart', a.byDevice ?? []);
            renderAnalyticsChart('analyticsOsChart', a.byOs ?? []);
            renderAnalyticsChart('analyticsBrowserChart', a.byBrowser ?? []);
        }

        function pollAnalytics() {
            fetch('/Dashboard/Analytics')
                .then(r => r.json())
                .then(a => updateAnalytics(a))
                .catch(() => {});
        }

        pollAnalytics();
        setInterval(pollAnalytics, 60000);
    </script>
    <script type="module">
        import { renderTimeline } from '/js/showtime-timeline.js';

        const container = document.getElementById('dashboardTimeline');
        fetch('/Dashboard/Timeline?date=' + encodeURIComponent(todayStr))
            .then(r => r.json())
            .then(data => renderTimeline(container, data, todayStr))
            .catch(() => { container.innerHTML = '<div class="timeline-empty text-error">Failed to load timeline.</div>'; });
    </script>
}
