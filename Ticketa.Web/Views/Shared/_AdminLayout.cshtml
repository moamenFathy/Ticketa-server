<!DOCTYPE HTML>
<html lang="en" data-theme="@(Context.Request.Cookies["theme"] ?? "light")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ticketa Admin</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/Ticketa.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.css" />
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="font-sans antialiased">
    <nav class="navbar w-full bg-base-300/80 backdrop-blur-md border-b border-base-300 flex justify-between sticky top-0 z-40">
        <div class="flex items-center gap-2">
            <label id="drawerToggleBtn" for="my-drawer-4" aria-label="open sidebar" class="btn btn-square btn-ghost swap swap-rotate">
                <input id="drawerSwapState" type="checkbox" class="hidden" />
                <svg class="swap-off my-1.5 inline-block size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h18" /><path d="M3 6h18" /><path d="M3 18h18" /></svg>
                <svg class="swap-on my-1.5 inline-block size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
            </label>
            <a class="flex items-center gap-2.5 px-2 py-1 rounded-lg hover:bg-base-content/5 transition-all group" asp-controller="Dashboard" asp-action="Index">
                <img src="~/images/final_logo.svg" alt="Ticketa" class="size-8 object-contain drop-shadow-sm group-hover:scale-105 transition-transform" />
                <div class="flex items-center gap-2">
                    <span class="font-black text-xl tracking-tighter uppercase leading-none">
                        ticke<span class="text-primary">ta</span>
                    </span>
                    <span class="badge badge-sm badge-primary/15 text-primary border border-primary/30 font-bold uppercase tracking-wider text-[10px] py-0.5">
                        Admin
                    </span>
                </div>
            </a>
        </div>
        <div class="px-4 flex gap-2">
            <label class="btn btn-ghost btn-circle swap swap-rotate">
                <!-- this hidden checkbox controls the state -->
                <input id="themeToggle" type="checkbox" @(Context.Request.Cookies["theme"] == "dark" ? "checked" : "") />

                <!-- sun icon -->
                <svg class="swap-on h-5 w-5 fill-current"
                     xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24">
                    <path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z" />
                </svg>

                <!-- moon icon -->
                <svg class="swap-off h-5 w-5 fill-current"
                     xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24">
                    <path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z" />
                </svg>
            </label>

            <div class="dropdown dropdown-end">
                <button tabindex="0" role="button" class="btn btn-ghost btn-circle relative" aria-label="Notifications">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
                    <span id="notificationDot" class="hidden absolute top-0.5 right-0.5 size-2.5 rounded-full bg-primary animate-pulse"></span>
                </button>
                <div tabindex="-1" class="dropdown-content bg-base-100 rounded-box z-1 mt-3 w-80 p-2 shadow border border-base-200">
                    <ul id="notificationList" class="max-h-96 overflow-y-auto">
                        <li class="px-4 py-4 text-sm text-base-content/50 text-center">Loading...</li>
                    </ul>
                </div>
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="hidden lg:flex gap-3">
                    <div class="dropdown dropdown-end">
                        <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar" aria-label="User menu">
                            <div class="w-10 rounded-full">
                                <img alt="User avatar" src="https://ui-avatars.com/api/?name=@(Uri.EscapeDataString(User.Identity?.Name!) ?? "User")&background=random" />
                            </div>
                        </div>
                        <ul tabindex="-1" class="menu menu-sm dropdown-content bg-base-100 rounded-box z-1 mt-3 w-56 p-2 shadow-lg border border-base-200">
                            <li class="menu-title px-3 py-1.5 text-xs opacity-60 font-semibold border-b border-base-200 mb-1 truncate">
                                @User.Identity?.Name
                            </li>
                            <li>
                                <a asp-controller="Auth" asp-action="Logout" class="flex items-center justify-between w-full !text-red-500 hover:!bg-red-500/15 hover:!text-red-600 active:!bg-red-500/25 font-semibold rounded-lg px-3 py-2 transition-all group mt-1">
                                    <span class="text-red-500 group-hover:text-red-600 font-semibold">Logout</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="size-4 text-red-500 stroke-red-500 group-hover:translate-x-0.5 transition-transform"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            }
            else
            {
                <div class="hidden lg:flex gap-2">
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-ghost btn-sm px-4">Log in</a>
                </div>
            }

        </div>
    </nav>

    <div class="drawer lg:drawer-open h-[calc(100vh-4rem)]">
        <input id="my-drawer-4" type="checkbox" class="drawer-toggle" />
        <div class="drawer-content h-full overflow-y-auto">
            <div class="p-4">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>

        <div class="drawer-side is-drawer-close:overflow-visible lg:sticky lg:top-0 lg:h-[calc(100vh-4rem)]">
            <label for="my-drawer-4" aria-label="close sidebar" class="drawer-overlay"></label>
            <div class="flex h-full flex-col items-start bg-base-200 is-drawer-close:w-14 is-drawer-open:w-64 border-r border-base-300 transition-all">
                <div class="w-full px-4 py-3 border-b border-base-300/60 is-drawer-close:hidden flex items-center gap-3">
                    <img src="~/images/final_logo.svg" alt="Ticketa" class="size-6 object-contain" />
                    <div class="flex flex-col">
                        <span class="text-xs font-black tracking-tight leading-none uppercase">Ticketa</span>
                        <span class="text-[8px] font-bold tracking-[0.25em] text-primary uppercase mt-0.5">Control Panel</span>
                    </div>
                </div>
                <!-- Sidebar content here -->
                <ul class="menu w-full grow">
                    <li>
                        <a class="is-drawer-close:tooltip is-drawer-close:tooltip-right @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "menu-active font-bold" : "")" data-tip="Homepage" asp-controller="Dashboard" asp-action="Index">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor" class="my-1.5 inline-block size-4">
                                <path d="M3 3v16a2 2 0 0 0 2 2h16" />
                                <path d="M7 11.207a.5.5 0 0 1 .146-.353l2-2a.5.5 0 0 1 .708 0l3.292 3.292a.5.5 0 0 0 .708 0l4.292-4.292a.5.5 0 0 1 .854.353V16a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1z" />
                            </svg>
                            <span class="is-drawer-close:hidden">Homepage</span>
                        </a>
                    </li>

                    <li>
                        <a class="is-drawer-close:tooltip is-drawer-close:tooltip-right @(ViewContext.RouteData.Values["controller"]?.ToString() == "Payments" ? "menu-active font-bold" : "")" data-tip="Payments" asp-controller="Payments" asp-action="Index">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor" class="my-1.5 inline-block size-4">
                                <rect width="20" height="12" x="2" y="6" rx="2" />
                                <circle cx="12" cy="12" r="2" />
                                <path d="M6 12h.01M18 12h.01" />
                            </svg>
                            <span class="is-drawer-close:hidden">Payments</span>
                        </a>
                    </li>

                    <li>
                        <a class="is-drawer-close:tooltip is-drawer-close:tooltip-right @(ViewContext.RouteData.Values["controller"]?.ToString() == "Movies" ? "menu-active font-bold" : "")" data-tip="Movies" asp-controller="Movies" asp-action="Index">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor" class="my-1.5 inline-block size-4"><path d="m12.296 3.464 3.02 3.956" /><path d="M20.2 6 3 11l-.9-2.4c-.3-1.1.3-2.2 1.3-2.5l13.5-4c1.1-.3 2.2.3 2.5 1.3z" /><path d="M3 11h18v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><path d="m6.18 5.276 3.1 3.899" /></svg>
                            <span class="is-drawer-close:hidden">Movies</span>
                        </a>
                    </li>

                    <li>
                        <a class="is-drawer-close:tooltip is-drawer-close:tooltip-right @(ViewContext.RouteData.Values["controller"]?.ToString() == "Showtime" ? "menu-active font-bold" : "")" data-tip="Showtimes" asp-controller="Showtime" asp-action="Index">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor" class="my-1.5 inline-block size-4">
                                <path d="M18 8a2 2 0 0 0 0-4 2 2 0 0 0-4 0 2 2 0 0 0-4 0 2 2 0 0 0-4 0 2 2 0 0 0 0 4" />
                                <path d="M10 22 9 8" />
                                <path d="m14 22 1-14" />
                                <path d="M20 8c.5 0 .9.4.8 1l-2.6 12c-.1.5-.7 1-1.2 1H7c-.6 0-1.1-.4-1.2-1L3.2 9c-.1-.6.3-1 .8-1Z" />
                            </svg>
                            <span class="is-drawer-close:hidden">Showtimes</span>
                        </a>
                    </li>

                    <li>
                        <a class="is-drawer-close:tooltip is-drawer-close:tooltip-right @(ViewContext.RouteData.Values["controller"]?.ToString() == "Hall" ? "menu-active font-bold" : "")" data-tip="Halls" asp-controller="Hall" asp-action="Index">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor" class="my-1.5 inline-block size-4">
                                <path d="M19 9V6a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v3" />
                                <path d="M3 16a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5a2 2 0 0 0-4 0v1.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V11a2 2 0 0 0-4 0z" />
                                <path d="M5 18v2" />
                                <path d="M19 18v2" />
                            </svg>
                            <span class="is-drawer-close:hidden">Halls</span>
                        </a>
                    </li>

                    <li>
                        <a class="is-drawer-close:tooltip is-drawer-close:tooltip-right @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminUserManagement" ? "menu-active font-bold" : "")" data-tip="Users" asp-controller="AdminUserManagement" asp-action="Index">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor" class="my-1.5 inline-block size-4">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                                <circle cx="9" cy="7" r="4" />
                                <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                            </svg>
                            <span class="is-drawer-close:hidden">Users</span>
                        </a>
                    </li>

                    <li>
                        <a class="is-drawer-close:tooltip is-drawer-close:tooltip-right @(ViewContext.RouteData.Values["controller"]?.ToString() == "Role" ? "menu-active font-bold" : "")" data-tip="Roles" asp-controller="Role" asp-action="Index">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor" class="my-1.5 inline-block size-4">
                                <path d="M12 2a4 4 0 1 0 0 8 4 4 0 0 0 0-8z" />
                                <path d="M6.8 17a3.5 3.5 0 0 1 3.5-3.5h3.4a3.5 3.5 0 0 1 3.5 3.5" />
                                <path d="M18 5l3 3-3 3" />
                                <path d="M6 11l-3 3 3 3" />
                            </svg>
                            <span class="is-drawer-close:hidden">Roles</span>
                        </a>
                    </li>

                </ul>
            </div>
        </div>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div role="alert" class="alert alert-success shadow-lg" data-toast data-toast-duration="4000">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>@success</span>
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div role="alert" class="alert alert-error shadow-lg" data-toast data-toast-duration="5000">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>@error</span>
        </div>
    }

    @if (TempData["Warning"] is string Warning)
    {
        <div role="alert" class="alert alert-warning shadow-lg" data-toast data-toast-duration="5000">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-triangle-alert-icon lucide-triangle-alert"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" /><path d="M12 9v4" /><path d="M12 17h.01" /></svg>
            <span>@Warning</span>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/themeToggle.js" asp-append-version="true"></script>
    <script src="~/js/Modals.js" asp-append-version="true"></script>
    <script src="https://cdn.datatables.net/2.3.7/js/dataTables.js"></script>
    <script>
        const drawerToggle = document.getElementById("my-drawer-4");
        const drawerSwapState = document.getElementById("drawerSwapState");

        const syncDrawerSwap = () => {
        drawerSwapState.checked = drawerToggle.checked;
        };

        drawerToggle.addEventListener("change", syncDrawerSwap);
        syncDrawerSwap();
    </script>
    <script>
        var ls = window.localStorage;
        var seenSoldOutIds = (function() {
            try { return new Set(JSON.parse(ls.getItem('ticketaSeenSoldOutIds') || '[]').map(String)); }
            catch (e) { return new Set(); }
        })();
        var lastSoldOutIds = [];

        function saveSeenIds() {
            try { ls.setItem('ticketaSeenSoldOutIds', JSON.stringify([...seenSoldOutIds])); } catch (e) {}
        }

        function updateNotifications(data) {
            var soldOutIds = (data.soldOut || []).map(function(s) { return String(s.showtimeId); });
            lastSoldOutIds = soldOutIds;

            var hasUnseen = soldOutIds.some(function(id) { return !seenSoldOutIds.has(id); });
            var dot = document.getElementById('notificationDot');
            if (dot) dot.classList.toggle('hidden', !hasUnseen);

            var list = document.getElementById('notificationList');
            if (!list) return;

            var icons = { soldOut: '\uD83D\uDCB0', running: '\uD83D\uDFE2', completed: '\u2705' };
            var all = [];
            (data.soldOut || []).forEach(function(s) { all.push(Object.assign({}, s, { _t: 'soldOut' })); });
            (data.currentlyRunning || []).forEach(function(s) { all.push(Object.assign({}, s, { _t: 'running' })); });
            (data.recentlyCompleted || []).forEach(function(s) { all.push(Object.assign({}, s, { _t: 'completed' })); });

            all.sort(function(a, b) { return new Date(b.startTime) - new Date(a.startTime); });

            var activeIds = {};
            all.forEach(function(n) { activeIds[n.showtimeId] = true; });
            var pruned = [];
            seenSoldOutIds.forEach(function(id) { if (activeIds[id]) pruned.push(id); });
            seenSoldOutIds = new Set(pruned);
            saveSeenIds();

            var html = '';
            all.slice(0, 10).forEach(function(item) {
                var extra = '';
                if (item._t === 'completed') extra = new Date(item.archivedAt).toLocaleString();
                html += '<li class="px-4 py-2 hover:bg-base-200 text-sm flex items-start gap-2"' + (item.showtimeId ? ' data-showtime-id="' + item.showtimeId + '"' : '') + '>' +
                    '<span>' + icons[item._t] + '</span>' +
                    '<div>' +
                        '<p class="font-medium">' + item.movieTitle + '</p>' +
                        '<p class="text-xs text-base-content/50">' + item.hallName + ' · ' + new Date(item.startTime).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'}) + (extra ? ' · ' + extra : '') + '</p>' +
                    '</div>' +
                '</li>';
            });
            list.innerHTML = html || '<li class="px-4 py-4 text-sm text-base-content/50 text-center">No notifications</li>';
        }

        document.querySelector('[aria-label="Notifications"]')?.addEventListener('focus', function() {
            lastSoldOutIds.forEach(function(id) { seenSoldOutIds.add(id); });
            saveSeenIds();
            var dot = document.getElementById('notificationDot');
            if (dot) dot.classList.add('hidden');
        });

        (function pollNotifications() {
            fetch('/Dashboard/NotificationSummary')
                .then(function(r) { return r.json(); })
                .then(function(data) { updateNotifications(data); })
                .catch(function() {});
            setTimeout(pollNotifications, 15000);
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
