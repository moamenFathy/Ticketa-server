@model RoleUpsertVM

@{
    var isEdit = !string.IsNullOrEmpty(Model.Id);
    var title = isEdit ? "Edit Role" : "Create Role";
    var totalPerms = Model.AllPermissionsGrouped.Sum(g => g.Value.Count);
    var selectedPermsCount = Model.SelectedPermissions?.Count ?? 0;
}

<!-- Sheet Header -->
<div class="px-6 py-5 border-b border-base-300 flex items-center justify-between bg-base-100 shrink-0">
    <div class="flex items-center gap-3">
        <div class="size-10 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        </div>
        <div>
            <h3 class="text-lg font-bold leading-tight">@title</h3>
            <p class="text-xs text-base-content/60 mt-0.5">Configure role details and granular permissions access</p>
        </div>
    </div>
    <button type="button" class="btn btn-sm btn-ghost btn-circle hover:bg-base-200" onclick="closeRoleSheet()" aria-label="Close sheet">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
</div>

<!-- Scrollable Sheet Body / Form -->
<form class="flex flex-col flex-1 overflow-hidden"
      id="roleForm"
      method="post"
      asp-action="Upsert"
      asp-controller="Role"
      data-submit-url="/Role/Upsert">

    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />

    <div class="flex-1 overflow-y-auto px-6 py-6 space-y-6">
        <!-- Validation Summary -->
        <div asp-validation-summary="ModelOnly"
             class="text-error text-sm bg-error/10 border border-error/20 p-3 rounded-xl hidden" id="errorBanner"></div>

        <!-- Role Details Section -->
        <div class="bg-base-200/40 rounded-2xl p-4 border border-base-300 space-y-4">
            <!-- Role Name -->
            <div class="form-control w-full">
                <label class="label pb-1.5 pt-0">
                    <span class="label-text font-semibold text-sm">Role Name <span class="text-error">*</span></span>
                </label>
                <input asp-for="Name"
                       class="input input-bordered w-full bg-base-100 focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary font-medium"
                       placeholder="e.g. Cinema Manager, Content Editor"
                       autofocus />
                <span asp-validation-for="Name" class="text-error mt-1 text-xs font-semibold"></span>
            </div>

            <!-- Admin Role Toggle Card -->
            <label class="flex items-center justify-between p-3 rounded-xl bg-base-100 border border-base-300/80 cursor-pointer hover:border-primary/40 transition-colors">
                <div class="space-y-0.5 pr-4">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-semibold">Admin Access Privileges</span>
                        <span class="badge badge-xs badge-primary/20 text-primary font-bold">Admin Portal</span>
                    </div>
                    <p class="text-xs text-base-content/60 leading-relaxed">
                        Users with this role are granted administrative portal access and visible in user management.
                    </p>
                </div>
                <input asp-for="IsAdminRole" type="checkbox" class="toggle toggle-primary shrink-0" />
            </label>
        </div>

        <!-- Permissions Section -->
        <div class="space-y-3">
            <!-- Permissions Header & Toolbar -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-1 border-b border-base-300">
                <div class="flex items-center gap-2">
                    <span class="text-sm font-bold uppercase tracking-wider text-base-content/80">Permissions Matrix</span>
                    <span class="badge badge-primary badge-sm font-semibold" id="permCounter">@selectedPermsCount / @totalPerms Selected</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <button type="button" class="btn btn-xs btn-ghost border border-base-300 hover:border-primary/50 text-xs" id="btnSelectAllPerms">
                        Select All
                    </button>
                    <button type="button" class="btn btn-xs btn-ghost border border-base-300 hover:border-error/50 text-xs" id="btnDeselectAllPerms">
                        Deselect All
                    </button>
                </div>
            </div>

            <!-- Grouped Permission Cards Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-1">
                @foreach (var group in Model.AllPermissionsGrouped)
                {
                    var groupClass = "perm-group-" + group.Key;
                    var groupTotal = group.Value.Count;
                    var groupSelected = group.Value.Count(p => Model.SelectedPermissions?.Contains(p) == true);
                    var isGroupAllSelected = groupSelected == groupTotal && groupTotal > 0;

                    <div class="card bg-base-200/40 border border-base-300 rounded-xl overflow-hidden hover:border-base-300/80 transition-colors">
                        <div class="p-3.5 space-y-2.5">
                            <!-- Group Header -->
                            <div class="flex items-center justify-between border-b border-base-300 pb-2">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-bold">@group.Key</span>
                                    <span class="text-[10px] font-semibold text-base-content/50 group-counter" data-group="@groupClass">@groupSelected/@groupTotal</span>
                                </div>
                                <label class="label cursor-pointer gap-1.5 p-0">
                                    <span class="label-text text-[11px] font-medium text-base-content/70">All</span>
                                    <input type="checkbox"
                                           class="checkbox checkbox-xs checkbox-primary select-all"
                                           data-group="@groupClass"
                                           checked="@isGroupAllSelected" />
                                </label>
                            </div>

                            <!-- Group Checkboxes -->
                            <div class="flex flex-col gap-1">
                                @foreach (var permission in group.Value)
                                {
                                    var isChecked = Model.SelectedPermissions?.Contains(permission) == true;
                                    var actionName = permission.Split(':').Last();
                                    <label class="flex items-center gap-2.5 py-1.5 px-2 rounded-lg hover:bg-base-100 cursor-pointer transition-colors">
                                        <input type="checkbox"
                                               name="SelectedPermissions"
                                               value="@permission"
                                               class="checkbox checkbox-sm checkbox-primary perm-check @groupClass shrink-0"
                                               checked="@isChecked" />
                                        <span class="text-xs font-medium capitalize text-base-content/85">@actionName</span>
                                    </label>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Sticky Bottom Sheet Footer -->
    <div class="px-6 py-4 border-t border-base-300 bg-base-100 flex items-center justify-end gap-3 shrink-0 shadow-lg">
        <button type="button" class="btn btn-ghost border border-base-300 hover:bg-base-200" onclick="closeRoleSheet()">
            Cancel
        </button>
        <button class="btn btn-primary px-6 hover:brightness-110 font-bold" type="submit">
            @(isEdit ? "Save Changes" : "Create Role")
        </button>
    </div>
</form>
